PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kitchen_costing
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10

# Optional
NODE_ENV=development
API_PREFIX=api
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
BCRYPT_SALT_ROUNDS=10
# Set to false when running a standalone (non replica-set) MongoDB
USE_TRANSACTIONS=true
